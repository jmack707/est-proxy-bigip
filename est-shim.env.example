# Copy to /etc/est-shim/est-shim.env on the host running est_shim.py, mode 0600.
# Needs a Vault/OpenBao AppRole (or adapt bao_login() for another auth method)
# scoped to <pki_mount>/issue/<role> and <pki_mount>/sign/<role> -- for the
# exact policy shape see the est-shim policy in bootstrap-openbao-dev.sh,
# and docs/install.md step 1.
BAO_ADDR=https://127.0.0.1:8200
BAO_ROLE_ID=<your AppRole role_id>
BAO_SECRET_ID=<your AppRole secret_id>
PKI_MOUNT=pki_int
PKI_ROLE=example-dot-com
DOMAIN=example.com
LISTEN_PORT=8085

# --- optional: LDAP (FreeIPA or Active Directory) client authentication ---
# Gates simpleenroll on an HTTP-Basic-Auth LDAP bind. simplereenroll is left
# alone -- it already authenticates via the client's existing TLS cert.
LDAP_ENABLED=false
LDAP_URI=ldaps://127.0.0.1:636

# {username} is substituted with the HTTP-Basic-Auth username.
#   FreeIPA: uid={username},cn=users,cn=accounts,dc=example,dc=com
#   AD (UPN, simplest):  {username}@example.com
#   AD (DN):             CN={username},CN=Users,DC=example,DC=com
LDAP_BIND_DN_TEMPLATE=uid={username},cn=users,cn=accounts,dc=example,dc=com

# Only relevant for ldap:// (not ldaps://) -- upgrade the connection with
# STARTTLS before binding.
LDAP_START_TLS=false

# Comma-separated EST operations that require the LDAP bind to succeed.
LDAP_REQUIRE_OPS=simpleenroll

# Reject if the CSR's CN doesn't match the authenticated LDAP username --
# stops an authenticated user from requesting a cert identifying someone
# else. Set to false if your CNs intentionally differ from usernames (e.g.
# device hostnames enrolled by a shared service account).
LDAP_ENFORCE_CN_MATCH=true

# --- proxy trust -------------------------------------------------------------
# Shared secret the est_proxy iRule presents as X-EST-Proxy-Secret. Deploy the
# same value with `deploy_bigip.py --proxy-secret`. Unset means the shim cannot
# tell a proxied request from one that reached the port directly, and the
# X-SSL-Client-* headers below become attacker-supplied.
EST_PROXY_SECRET=

# Verify the forwarded client certificate against the issuing CA on reenroll,
# instead of trusting that the header exists. Leave true.
REENROLL_VERIFY_CERT=true

# --- authentication rate limiting --------------------------------------------
# Failed binds per username inside the window before the shim answers 429.
# 0 disables. Every gated enrolment is a live directory bind, so this bounds
# both password guessing and account-lockout denial of service.
AUTH_MAX_FAILURES=5
AUTH_WINDOW_SECONDS=300

# CA bundle used to verify the directory's TLS certificate. Unset means the
# LDAPS session is encrypted but the server is not authenticated.
LDAP_CA_FILE=
