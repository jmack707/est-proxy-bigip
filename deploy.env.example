# est-proxy-bigip deployment configuration.
#
# Copy this to deploy.env, fill in every value for your environment, then
# run: ./quickstart.sh
#
# This drives Parts 0, 2, and 3 of DEPLOY-AD.md non-interactively: stands
# up dev-mode OpenBao, configures + starts the EST shim, deploys the BIG-IP
# objects, and issues+installs the VS's own bootstrap certificate. Part 1
# (AD/LDAPS setup) and Part 4 (testing with estclient) are still manual --
# see DEPLOY-AD.md.

# --- domain ---
# Used for the OpenBao PKI role's allowed_domains and the shim's DOMAIN var.
DOMAIN=f5lab.local

# --- backend host (runs the EST shim + OpenBao via `docker compose`) ---
# The IP the BIG-IP pool member will use to reach the shim -- i.e. this
# host's own address on the network BIG-IP can route to, not 127.0.0.1.
# (The shim's own port is fixed at 8085 -- docker-compose.yml's port
# mapping isn't parameterized, so changing it here wouldn't do anything.)
BACKEND_HOST=10.1.20.14

# --- BIG-IP ---
BIGIP_HOST=10.1.1.4
BIGIP_USER=admin
BIGIP_PASS=admin
VS_DESTINATION=10.1.10.100:8443
VS_VLAN=/Common/external
# Hostname the VS's own bootstrap certificate is issued for -- this is
# what you'll connect estclient to with -s in Part 4. Must resolve (e.g.
# via /etc/hosts on your test client) to VS_DESTINATION's IP.
VS_HOSTNAME=est.f5lab.local

# --- LDAP (FreeIPA or Active Directory) -- leave LDAP_ENABLED=false to skip ---
LDAP_ENABLED=true
LDAP_URI=ldaps://10.1.1.10:636
# {username} substituted with the HTTP-Basic-Auth username.
#   FreeIPA: uid={username},cn=users,cn=accounts,dc=f5lab,dc=local
#   AD (UPN, simplest): {username}@f5lab.local
LDAP_BIND_DN_TEMPLATE={username}@f5lab.local
LDAP_START_TLS=false
LDAP_ENFORCE_CN_MATCH=true
